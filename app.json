{
  "expo": {
    "name": "Legalistas",
    "slug": "legalistas-app",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09A4B5"
    },
    "ios": {
      "bundleIdentifier": "com.lexiatechs.legalistas",
      "buildNumber": "9",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Permite tomar fotos para adjuntar a consultas legales.",
        "NSPhotoLibraryUsageDescription": "Permite seleccionar imágenes para enviar documentación.",
        "NSCalendarsUsageDescription": "Necesitamos acceso al calendario para agendar citas legales.",
        "NSLocationWhenInUseUsageDescription": "Esta app no utiliza tu ubicación. Este permiso es requerido por servicios de notificaciones para mejorar la entrega de avisos de tu caso."
      }
    },
    "android": {
      "package": "com.lexiatechs.legalistas",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09A4B5"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-calendar",
        {
          "calendarPermission": "Necesitamos acceso al calendario para agendar citas legales."
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.63915417330-s6mu2q8os2sptdomvhe504i9l8q27emo"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "privacyManifests": {
              "NSPrivacyAccessedAPITypes": [
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                  "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
                  "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
                  "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
                }
              ]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9b07e3e4-43c1-4a0e-b46f-b0fdde542298"
      },
      "onesignalAppId": "9840b2a5-1270-4ef3-9057-add0cd4ab778"
    },
    "owner": "legalistaswebs-organization"
  }
}
